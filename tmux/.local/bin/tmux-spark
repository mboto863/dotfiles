#!/usr/bin/env bash
# bin/tmux-spark

SESSION="Spark"

# Start a new detached tmux session and name the first window "pyspark"
tmux new-session -d -s $SESSION -n "Shell"

# Window 1:  PySpark shell.
tmux send-keys -t $SESSION:Shell "uv run pyspark" C-m

# Window 2: Monitor
tmux new-window -t $SESSION -n "Monitor"
tmux send-keys -t $SESSION:Monitor "btop" C-m

tmux select-window -t $SESSION:Shell